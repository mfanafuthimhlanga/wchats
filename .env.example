# ==============================================================================
# W Chats — environment variables (repo root)
#
# Copy to  .env  and fill in your values. NEVER commit .env.
#
# WHICH FILE THE API ACTUALLY LOADS
#   app/core/config.py::_find_env_file() walks UP from apps/api/app/core/ and
#   stops at the FIRST .env it finds. On a fresh clone that is this file. Once
#   apps/api/.env exists it wins, and this one is never read again — so if you
#   edit here and nothing changes, look there first.
#
# The three env files in this repo:
#   .env                      this file — the API/worker, on a fresh clone
#   apps/api/.env             the API/worker once it exists; FULL knob list in
#                             apps/api/.env.example (thresholds, SMTP, OTP, ...)
#   apps/admin/.env.local     the Next.js console — see
#                             apps/admin/.env.local.example (Clerk, API base)
#
# The REQUIRED block below is pinned by
#   apps/api/tests/unit/test_env_example_covers_required_settings.py
# which derives the list from Settings.model_fields at test time.
# ==============================================================================


# ==============================================================================
# REQUIRED — all 10. Settings declares these with no default, so pydantic raises
# ValidationError at import of app.core.config when any one is absent: the API,
# the Celery workers and every alembic command fail before doing any work.
# ==============================================================================

# ------------------------------------------------------------------------------
# Neon — per-tenant PostgreSQL projects
# Get an API key from https://console.neon.tech/app/settings/api-keys
# ------------------------------------------------------------------------------
NEON_API_KEY=<your-neon-api-key>

# Fernet key encrypting tenant connection strings at rest in the control DB.
# Generate with:
#   python -c "import os,base64; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
NEON_ENCRYPTION_KEY=<generate-with-the-command-above>

# HKDF key material for per-tenant credential derivation (INT-01). Same
# base64url-encoded-32-bytes convention as NEON_ENCRYPTION_KEY, and it must be a
# DIFFERENT value — generate it separately with the same command.
PLATFORM_CREDENTIAL_KEY=<generate-with-the-command-above>

# ------------------------------------------------------------------------------
# Control DB — two URLs over the SAME database.
#   CONTROL_DB_URL      postgresql+asyncpg://  FastAPI's async engine
#   CONTROL_DB_SYNC_URL postgresql://          Celery's sync engine + Alembic CLI
# A mismatch between them is a silent split-brain, not an error.
#
# Development runs locally — no containers (CLAUDE.md rule 6). A local
# PostgreSQL 17 with pgvector and a local redis-server are the supported setup.
# ------------------------------------------------------------------------------
CONTROL_DB_URL=postgresql+asyncpg://wchats:wchats@localhost:5432/wchats_control
CONTROL_DB_SYNC_URL=postgresql://wchats:wchats@localhost:5432/wchats_control

# ------------------------------------------------------------------------------
# Platform auth
# ------------------------------------------------------------------------------
# X-Admin-Key for the POST /tenants bootstrap endpoint. Generate with:
#   python -c "import secrets; print('vrd_admin_'+secrets.token_urlsafe(32))"
ADMIN_KEY=<generate-with-the-command-above>

# Signs widget session JWTs (M4). Unrelated to Clerk. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=<generate-with-the-command-above>

# Clerk Dashboard -> Webhooks -> your endpoint -> Signing Secret. Starts whsec_.
# The console's own Clerk keys live in apps/admin/.env.local, not here.
CLERK_WEBHOOK_SIGNING_SECRET=<whsec_-from-the-clerk-dashboard>

# ------------------------------------------------------------------------------
# Model providers
# ------------------------------------------------------------------------------
# https://console.anthropic.com/settings/keys
#
# NOTE: pydantic loads this file into Settings only. app/services/actor_seam.py
# builds anthropic.Anthropic() off os.environ, so the integration suite needs
# the key EXPORTED into the process environment as well — a .env line alone
# yields `401 invalid x-api-key` rather than a skip. See BACKLOG 1.13.
ANTHROPIC_API_KEY=<your-anthropic-api-key>

# https://dashboard.voyageai.com/api-keys — embeddings + rerank
VOYAGE_API_KEY=<your-voyage-api-key>


# ==============================================================================
# COMMON OPTIONALS — the full list, with defaults, is in apps/api/.env.example.
# ==============================================================================

# Celery broker + SSE pub/sub.
# REDIS_URL=redis://localhost:6379/0

# Region for newly provisioned tenant projects.
# NEON_REGION=aws-us-east-1

# DEBUG | INFO | WARNING | ERROR | CRITICAL
# LOG_LEVEL=INFO

# Leave empty to disable Sentry.
# SENTRY_DSN=

# JSON array of origins allowed to call the API. Add your console origin here.
# CORS_ORIGINS=["http://localhost:3000"]

# "production" disables the OpenAPI docs routes (WR-04).
# ENVIRONMENT=development
