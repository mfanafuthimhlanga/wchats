# ==============================================================================
# W Chats — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Neon (per-tenant PostgreSQL projects)
# Get your API key from: https://console.neon.tech/app/settings/api-keys
# ------------------------------------------------------------------------------
NEON_API_KEY=<your-neon-api-key>

# Neon region for new tenant projects.
# Run: neon regions list  (or see https://neon.tech/docs/introduction/regions)
NEON_REGION=aws-us-east-1

# Fernet encryption key for tenant connection strings stored in the control DB.
# Generate with:
#   python -c "import os, base64; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
NEON_ENCRYPTION_KEY=<run: python -c "import os,base64; print(base64.urlsafe_b64encode(os.urandom(32)).decode())">

# ------------------------------------------------------------------------------
# Control DB (shared Neon project — or local postgres for development)
# When running via docker-compose, these are overridden in the compose file
# to point at the internal 'postgres' service hostname.
# ------------------------------------------------------------------------------
CONTROL_DB_URL=postgresql+asyncpg://wchats:wchats@localhost:5432/wchats_control
CONTROL_DB_SYNC_URL=postgresql://wchats:wchats@localhost:5432/wchats_control

# ------------------------------------------------------------------------------
# Redis (Celery broker + SSE pub/sub)
# When running via docker-compose, this is overridden to redis://redis:6379/0
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# Observability
# ------------------------------------------------------------------------------
# Log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Sentry DSN — leave empty to disable Sentry error tracking
SENTRY_DSN=

# ------------------------------------------------------------------------------
# Security
# ------------------------------------------------------------------------------
# Admin key for the POST /tenants bootstrap endpoint (X-Admin-Key header).
# Generate with:
#   python -c "import secrets; print('vrd_admin_' + secrets.token_urlsafe(32))"
ADMIN_KEY=<run: python -c "import secrets; print('vrd_admin_'+secrets.token_urlsafe(32))">

# CORS origins that may access the API (JSON array of origin strings).
# Add your admin UI origin here. Widget CORS is configured in M4.
CORS_ORIGINS=["http://localhost:3000"]
