NEXT_PUBLIC_API_BASE=http://localhost:8000

# The embed snippet is no longer built in the browser (BACKLOG 7.1). The console
# reads it from GET /api/v1/agents/{id}/embed-snippet, and the API composes it
# from its own WIDGET_CDN_BASE and PUBLIC_API_BASE (apps/api/.env.example).
# NEXT_PUBLIC_WCHATS_WIDGET_CDN and NEXT_PUBLIC_WCHATS_API_BASE were the console
# half of a second generator that disagreed with the API's; set the two API-side
# settings instead.
