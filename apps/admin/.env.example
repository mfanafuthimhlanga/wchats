NEXT_PUBLIC_API_BASE=http://localhost:8000

# Widget embed snippet env vars (populated from Terraform outputs: widget_cdn_url and api_url from 13-01)
# CloudFront distribution URL for the widget JS loader (Terraform output: widget_cdn_url)
NEXT_PUBLIC_WCHATS_WIDGET_CDN=https://widget.wchats.app
# Stable production API domain for the data-api embed attribute (Terraform output: api_url)
NEXT_PUBLIC_WCHATS_API_BASE=https://api.wchats.app
