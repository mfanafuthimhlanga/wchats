FROM python:3.12-slim

# System dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libpq-dev \
    libxcb1 \
    libgl1 \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    && rm -rf /var/lib/apt/lists/*

# Install uv
RUN pip install --no-cache-dir uv

# Create non-root user
RUN useradd -m -s /bin/bash appuser

WORKDIR /app

# CPU-only torch + torchvision first — prevents docling pulling CUDA/triton
COPY pyproject.toml ./
RUN uv pip install --system --no-cache torch torchvision --index-url https://download.pytorch.org/whl/cpu
RUN uv pip install --system --no-cache ".[dev,pipeline]"

# Copy application code
COPY . /app

# Transfer ownership to non-root user
RUN chown -R appuser /app

USER appuser

CMD ["celery", "-A", "app.worker.celery_app", "worker", "--queues=pipeline", "--hostname=pipeline@%h", "--loglevel=info"]
