FROM python:3.12-slim

# System dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libpq-dev \
    libxcb1 \
    libgl1 \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    && rm -rf /var/lib/apt/lists/*

# Install uv
RUN pip install --no-cache-dir uv

# Create non-root user
RUN useradd -m -s /bin/bash appuser

WORKDIR /app

# CPU-only torch + torchvision first — prevents docling pulling CUDA/triton
COPY pyproject.toml ./
RUN uv pip install --system --no-cache torch torchvision --index-url https://download.pytorch.org/whl/cpu
RUN uv pip install --system --no-cache ".[dev,pipeline]"

# Copy application code
COPY . /app

# Transfer ownership to non-root user
RUN chown -R appuser /app

# rapidocr downloads its OCR weights into its own package directory on first
# use, and that directory is root's. Observed on staging 2026-09-05 as
# worker.docling_warmup_failed error="[Errno 13] Permission denied:
# '/usr/local/lib/python3.12/site-packages/rapidocr/models/PP-OCRv6_det_small.pth'",
# which would recur on every first parse, warm-up or not. The directory is
# resolved from the installed package rather than spelled out, so a Python or
# package bump moves it with the install.
RUN d="$(python -c "import os, rapidocr; print(os.path.join(os.path.dirname(rapidocr.__file__), 'models'))")"     && mkdir -p "$d" && chown -R appuser "$d"

USER appuser

CMD ["celery", "-A", "app.worker.celery_app", "worker", "--queues=pipeline", "--hostname=pipeline@%h", "--loglevel=info"]
