# ==============================================================================
# W Chats API — environment variables
#
# Copy to  apps/api/.env  and fill in real values. NEVER commit .env.
#
# WHICH FILE ACTUALLY LOADS
#   app/core/config.py::_find_env_file() walks UP from app/core/ and stops at
#   the FIRST .env it finds — so with this repo laid out as it is, that is
#   apps/api/.env. The repo-root .env is only reached when this one does not
#   exist. If you edit the root file and nothing changes, this is why.
#
# The REQUIRED block below is pinned by
#   tests/unit/test_env_example_covers_required_settings.py
# which derives the list from Settings.model_fields at test time. Add a field
# with no default to config.py and that test fails until it lands here too.
# ==============================================================================


# ==============================================================================
# REQUIRED — all 10. Settings declares these with no default, so pydantic raises
# ValidationError at import of app.core.config when any one is absent: the API,
# the Celery workers and every alembic command fail before doing any work.
# ==============================================================================

# ------------------------------------------------------------------------------
# Neon — per-tenant PostgreSQL projects (never schema-per-tenant; see CLAUDE.md)
# ------------------------------------------------------------------------------
# https://console.neon.tech/app/settings/api-keys
NEON_API_KEY=<your-neon-api-key>

# Fernet key encrypting tenant connection strings at rest in the control DB.
# Generate with:
#   python -c "import os,base64; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
NEON_ENCRYPTION_KEY=<generate-with-the-command-above>

# HKDF key material for per-tenant credential derivation (INT-01). Same
# base64url-encoded-32-bytes convention as NEON_ENCRYPTION_KEY, and it must be a
# DIFFERENT value — generate it separately with the same command.
PLATFORM_CREDENTIAL_KEY=<generate-with-the-command-above>

# ------------------------------------------------------------------------------
# Control DB — two URLs over the SAME database.
#   CONTROL_DB_URL      postgresql+asyncpg://  FastAPI's async engine
#   CONTROL_DB_SYNC_URL postgresql://          Celery's sync engine + Alembic CLI
# A mismatch between them is a silent split-brain, not an error.
# ------------------------------------------------------------------------------
CONTROL_DB_URL=postgresql+asyncpg://wchats:wchats@localhost:5432/wchats_control
CONTROL_DB_SYNC_URL=postgresql://wchats:wchats@localhost:5432/wchats_control

# ------------------------------------------------------------------------------
# Platform auth
# ------------------------------------------------------------------------------
# X-Admin-Key for the POST /tenants bootstrap endpoint. Generate with:
#   python -c "import secrets; print('vrd_admin_'+secrets.token_urlsafe(32))"
ADMIN_KEY=<generate-with-the-command-above>

# Signs widget session JWTs (M4). Unrelated to Clerk. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=<generate-with-the-command-above>

# Clerk Dashboard -> Webhooks -> your endpoint -> Signing Secret. Starts whsec_.
# Clerk is load-bearing beyond sign-in: the human-label path refuses anything
# that is not a Clerk JWT (BACKLOG 4.7). Production needs a PRODUCTION Clerk
# instance — the admin console currently runs on development keys (BACKLOG 1.20).
CLERK_WEBHOOK_SIGNING_SECRET=<whsec_-from-the-clerk-dashboard>

# ------------------------------------------------------------------------------
# Model providers
# ------------------------------------------------------------------------------
# THE DEFAULT PROVIDER IS DEEPSEEK (owner decision 2026-08-15; mechanism and
# fallback in .dev/MASTERPLAN.md §Model provider). DeepSeek's endpoint speaks
# the Anthropic Messages format, so ANTHROPIC_API_KEY carries a DEEPSEEK key
# (https://platform.deepseek.com/api_keys) and ANTHROPIC_BASE_URL points every
# client — the direct anthropic SDK and the CLI the Agent SDK spawns — at
# DeepSeek. Model names stay Anthropic-shaped; the endpoint maps
# claude-haiku/sonnet-* to deepseek-v4-flash and claude-opus-* to
# deepseek-v4-pro.
#
# To run against Anthropic instead: remove ANTHROPIC_BASE_URL and put an
# Anthropic key (https://console.anthropic.com/settings/keys) here. Judge
# calibration is per-provider (BACKLOG 0.1) — do not mix scores across the two.
#
# NOTE, and it has cost real debugging time three times (BACKLOG 1.13, 1.28):
# pydantic loads this file into Settings only, while every model client reads
# os.environ. BOTH names below must be EXPORTED into the environment of the
# API and every Celery worker — a .env line alone yields `401 invalid
# x-api-key`, or a worker that silently bills the wrong provider.
ANTHROPIC_API_KEY=<your-deepseek-api-key>

# Not a Settings field — os.environ only, which is why the export note above
# applies doubly here. This line IS the provider decision.
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic

# https://dashboard.voyageai.com/api-keys — embeddings + rerank
VOYAGE_API_KEY=<your-voyage-api-key>


# ==============================================================================
# OPTIONAL — every remaining Settings field, with the default it falls back to.
# Shown commented: uncomment only what you are actually changing.
# ==============================================================================

# --- Neon ---
# Region for newly provisioned tenant projects.
# NEON_REGION=aws-us-east-1
# Seconds psycopg2 may spend opening a tenant-DB connection. Tenant projects
# scale to zero and a suspended endpoint takes ~8-20s to wake, which is what
# the first message of a conversation pays. Budget is spent PER resolved
# address, so lowering this is how a cold start turns into a failed turn.
# TENANT_DB_CONNECT_TIMEOUT_S=30

# --- Redis — Celery broker + SSE pub/sub ---
# REDIS_URL=redis://localhost:6379/0
# WR-04: True allows CERT_NONE on rediss:// — MITM-exposed, local/dev only.
# REDIS_TLS_INSECURE=false
#
# The broker carries customer message text, so RDB snapshots must be off. That
# is a redis.conf setting (`save ""`), NOT an app setting — nothing here reads it.

# --- Observability ---
# LOG_LEVEL=INFO
# SENTRY_DSN=
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=https://cloud.langfuse.com

# --- HTTP surface ---
# JSON array of origins allowed to call the API.
# CORS_ORIGINS=["http://localhost:3000"]
# "production" disables the OpenAPI docs routes (WR-04).
# ENVIRONMENT=development

# --- Clerk ---
# CLERK_JWKS_URL=https://api.clerk.com/v1/jwks

# --- Uploads and ingestion ---
# MAX_UPLOAD_SIZE_MB=50
# S3 is the upload/parse hot path since PROD-13; UPLOADS_DIR is back-compat only.
# Unset, POST /agents/{id}/documents returns 503 naming this setting.
# S3_UPLOADS_BUCKET=
# UPLOADS_DIR=/vrd-uploads
#
# LOCAL DEVELOPMENT ONLY (BACKLOG 1.24). Points document storage at an
# S3-compatible process instead of AWS, so the ingestion chain can be run
# without an AWS account. This redirects every read and write of customer
# document bytes, so it is REFUSED when ENVIRONMENT=production — the process
# raises rather than honouring or silently ignoring it.
# S3_ENDPOINT_URL=http://127.0.0.1:9000

# --- Embeddings ---
# "bedrock" (default, IAM-authed, no RPM cap) | "voyage" (legacy fallback)
# Local development without an AWS account: set voyage, or embedding fails at
# the Bedrock client. VOYAGE_API_KEY above is already required.
# EMBEDDING_PROVIDER=bedrock
# AWS_REGION=us-east-1
# BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0
# Cohere reranker fallback (RET-05).
# COHERE_API_KEY=

# --- Escalation + digest email (all unset => structlog WARNING instead) ---
# send_digest_email returns early unless SMTP_HOST, SMTP_FROM and OWNER_EMAIL
# are ALL set. OWNER_EMAIL is a single operator address, never a customer's.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_FROM=noreply@example.com
# SMTP_USER=
# SMTP_PASSWORD=
# OWNER_EMAIL=owner@example.com

# --- Identity verification: OTP + verified sessions (M17) ---
# VERIFIED_SESSION_TTL_SECONDS=3600
# OTP_EMAIL_TTL_SECONDS=600
# OTP_SMS_TTL_SECONDS=300
# OTP_MAX_ATTEMPTS=5
# OTP_SEND_MAX_PER_WINDOW=3
# "twilio" | "africastalking". Credentials unset => NullSmsProvider (SMS off).
# SMS_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=+27XXXXXXXXX
# AT_API_KEY=
# AT_USERNAME=
# AT_SENDER_ID=

# --- Spend ceilings ---
# Per-tenant daily model spend, USD. Per-tenant override lives in the admin UI.
# TENANT_DAILY_BUDGET_USD=5.0
# Per-turn ceiling handed to ClaudeAgentOptions (T-04-03-06 DoS guardrail).
# AGENT_MAX_BUDGET_USD=0.50
# Skills whose max_amount_cents ceiling is below this skip the Actor judge
# entirely (ACT-03 cost control). 500 = $5.00.
# ACTOR_SKIP_MAX_AMOUNT_CENTS=500

# --- Eval + verified-QA thresholds ---
# VERIFIED_QA_CONFIDENCE_THRESHOLD=0.90
# VERIFIED_QA_HIT_THRESHOLD=0.93
# EVAL_FAITHFULNESS_THRESHOLD=0.90
# EVAL_RELEVANCY_THRESHOLD=0.90
# Fraction of live turns sampled for retrieval faithfulness (OPS-07). 0.1 = 10%.
# RETRIEVAL_FAITHFULNESS_SAMPLE_RATE=0.1

# --- Red team + deploy gate ---
# RED_TEAM_MAX_TURNS=5
# RED_TEAM_ATTACK_SEQUENCES=3
# When True, any high-severity finding blocks the deploy (DEP-03).
# DEP_BLOCK_ON_HIGH_RED_TEAM=true

# --- Alerting + weekly digest (M10 / OPS-04) ---
# ALERT_FAITHFULNESS_THRESHOLD=0.6
# ALERT_RED_TEAM_CRITICAL_COUNT=1
# DIGEST_ENABLED=true

# --- The embed snippet (BACKLOG 7.1) ---
# The two hosts the API writes into the <script> tag an owner pastes into their
# own site. The API is the only generator of that tag — the console renders
# GET /api/v1/agents/{id}/embed-snippet rather than composing one.
#
# Where widget.js and its index.html are served from.
# WIDGET_CDN_BASE=https://widget.wchats.app
#
# What the tag's data-api points at. LEFT UNSET, EVERY SNIPPET THIS DEPLOYMENT
# ISSUES POINTS AT http://localhost:8000 — the widget still renders on the
# customer's site and every message fails in the visitor's browser. The default
# is the local uvicorn address because it is the only value true on a fresh
# checkout; set it in every deployed environment.
# PUBLIC_API_BASE=http://localhost:8000

# --- Blast radius (Phase 18, BLR-01) ---
# Platform defaults, used when the tenants.* override columns are NULL.
# Configured-side ceilings — deliberately distinct from the observed-history
# figures computed over BLAST_RADIUS_OBSERVED_WINDOW_DAYS.
# BLAST_RADIUS_WARN_SINGLE_CENTS=50000
# BLAST_RADIUS_WARN_HOURLY_CENTS=200000
# BLAST_RADIUS_OBSERVED_WINDOW_DAYS=7
