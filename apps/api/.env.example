# Veridian API — Environment Variables Example
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# Neon
NEON_API_KEY=neon_api_PLACEHOLDER
NEON_REGION=aws-us-east-1
NEON_ENCRYPTION_KEY=base64url-encoded-32-bytes-PLACEHOLDER

# Database (control DB)
CONTROL_DB_URL=postgresql+asyncpg://user:password@localhost:5432/veridian
CONTROL_DB_SYNC_URL=postgresql://user:password@localhost:5432/veridian

# Redis
REDIS_URL=redis://localhost:6379/0

# Observability
LOG_LEVEL=INFO
SENTRY_DSN=

# Auth
ADMIN_KEY=vrd_admin_PLACEHOLDER

# CORS
CORS_ORIGINS=["http://localhost:3000"]

# Deployment
ENVIRONMENT=development

# Ingestion pipeline — M2 (T-02-01-01)
ANTHROPIC_API_KEY=sk-ant-PLACEHOLDER
VOYAGE_API_KEY=pa-PLACEHOLDER
MAX_UPLOAD_SIZE_MB=50
