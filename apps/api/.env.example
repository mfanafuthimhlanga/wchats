# Veridian API — Environment Variables Example
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# Neon
NEON_API_KEY=neon_api_PLACEHOLDER
NEON_REGION=aws-us-east-1
NEON_ENCRYPTION_KEY=base64url-encoded-32-bytes-PLACEHOLDER

# Database (control DB)
CONTROL_DB_URL=postgresql+asyncpg://user:password@localhost:5432/veridian
CONTROL_DB_SYNC_URL=postgresql://user:password@localhost:5432/veridian

# Redis
REDIS_URL=redis://localhost:6379/0

# Observability
LOG_LEVEL=INFO
SENTRY_DSN=

# Auth
ADMIN_KEY=vrd_admin_PLACEHOLDER

# CORS
CORS_ORIGINS=["http://localhost:3000"]

# Deployment
ENVIRONMENT=development

# Ingestion pipeline — M2 (T-02-01-01)
ANTHROPIC_API_KEY=sk-ant-PLACEHOLDER
VOYAGE_API_KEY=pa-PLACEHOLDER
MAX_UPLOAD_SIZE_MB=50

# M4 — Reasoning Engine + Widget
# JWT_SECRET=change-me-in-production
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_FROM=noreply@example.com
# OWNER_EMAIL=owner@example.com

# M4.1 — Clerk Auth (from Clerk Dashboard -> API Keys)
# CLERK_JWKS_URL=https://api.clerk.com/v1/jwks
# CLERK_WEBHOOK_SIGNING_SECRET=whsec_...

# M4.1 — Security Hardening
# Per-tenant daily Anthropic spend ceiling (USD). Override per-tenant in M5 admin UI.
# TENANT_DAILY_BUDGET_USD=5.0
#
# Redis broker — RDB snapshots disabled because broker carries customer message text
# Set this in redis.conf: save "" or start redis with --save ""
REDIS_SAVE_DISABLED=true  # reminder only — not read by app; set in redis.conf
