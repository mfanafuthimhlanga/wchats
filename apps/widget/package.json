{
  "name": "wchats-widget",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "postbuild": "node scripts/check-size.mjs && node scripts/check-theming-contract.mjs && node scripts/check-rendered-notice.mjs && node scripts/sync-embed.mjs",
    "check-size": "node scripts/check-size.mjs",
    "check:theming-contract": "node scripts/check-theming-contract.mjs",
    "check:embed-sync": "node scripts/sync-embed.mjs --check",
    "check:rendered-notice": "node scripts/check-rendered-notice.mjs",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "preact": "10.29.1"
  },
  "devDependencies": {
    "@preact/preset-vite": "2.10.5",
    "playwright-core": "1.61.1",
    "terser": "5.47.1",
    "vite": "8.0.13",
    "vitest": "^4.1.10"
  }
}
