# Catch any stray logs accidentally written outside /logs
*.log
*_err.log

# Celery runtime state
apps/api/celerybeat-schedule

# TypeScript build info
apps/admin/tsconfig.tsbuildinfo

# Git worktree / clone scratch dirs
.clone/

